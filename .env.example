# Application
CAMPUS_ENVIRONMENT=development
CAMPUS_JWT_SECRET=replace-with-at-least-32-random-characters
CAMPUS_COOKIE_SECURE=false
CAMPUS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Data services
CAMPUS_DATABASE_URL=postgresql+asyncpg://campus:campus@localhost:5432/campus_pilot
CAMPUS_REDIS_URL=redis://localhost:6379/0
CAMPUS_UPLOAD_DIR=./uploads/quarantine
CAMPUS_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
CAMPUS_OBJECT_STORAGE_BUCKET=campus-pilot-documents
CAMPUS_OBJECT_STORAGE_ACCESS_KEY=campus
CAMPUS_OBJECT_STORAGE_SECRET_KEY=change-me-local-only

# AI: mock works with no external credentials
CAMPUS_AI_PROVIDER=mock
CAMPUS_AI_ENDPOINT=
CAMPUS_AI_API_KEY=

# Observability
CAMPUS_OTLP_ENDPOINT=http://localhost:4317

# Web
API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
